; SELODEV Free Starter Kit — standalone, zero paid dependencies.
;
; THIS is the canonical project file. build-packages.sh copies it over
; project.godot in the staged copy, so whatever the editor does to the working
; file never reaches a buyer. Edit here, not there.
;
; The editor rewrites project.godot every time the project is opened and saved:
; it bumps config/features to whatever engine you ran, turns the autoload paths
; into uid:// references, and strips these comments. None of that is wanted in
; a shipped file, and config/features is actively harmful because it is the
; MINIMUM engine version: shipping 4.7 locks out every buyer still on 4.3.
;
; Every free Lite system is vendored in addons/. The autoloads are declared here
; directly so the story game boots whether or not the matching plugin is switched
; on: the plugins are the editor panels, the autoloads are the running game.
;
; Only four plugins ship enabled. Every Lite dock lands in the same slot as the
; Inspector, so switching all fourteen on puts twenty tabs in one tab bar and
; Godot hides them behind overflow arrows. Start Here turns the rest on one at a
; time, when the buyer asks for one.
;
; GameBootstrap must stay last — it reads content/ and wires whatever it finds.

config_version=5

[application]

config/name="SELODEV Free Starter Kit"
config/icon="res://icon.png"
run/main_scene="res://game/world.tscn"
config/features=PackedStringArray("4.3")

[autoload]

GameEvents="*res://chassis/game_events.gd"
SaveLite="*res://addons/save_load_lite/save_lite.gd"
QuestsLite="*res://addons/quests_lite/quest_manager_lite.gd"
DialoguesLite="*res://addons/dialogue_lite/dialogue_manager_lite.gd"
AudioLite="*res://addons/audio_lite/audio_lite.gd"
CombatLite="*res://addons/combat_lite/combat_events_lite.gd"
ControllersLite="*res://addons/controller_lite/controllers_bus_lite.gd"
EnemyAILite="*res://addons/enemy_ai_lite/enemy_ai_bus_lite.gd"
SceneFlowLite="*res://addons/scene_flow_lite/scene_flow_lite.gd"
GameBootstrap="*res://chassis/game_bootstrap.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=600

[editor_plugins]

enabled=PackedStringArray("res://addons/starter_kit/plugin.cfg", "res://addons/dialogue_lite/plugin.cfg", "res://addons/quests_lite/plugin.cfg", "res://addons/save_load_lite/plugin.cfg")
